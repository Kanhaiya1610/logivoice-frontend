# Same-origin local development uses the Vite /api proxy by default.
# GitHub Actions repository variable for production:
# VITE_API_BASE_URL=https://logivoice-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Local development uses the root path. Set /logivoice-frontend/ as the
# VITE_BASE_PATH repository variable for a GitHub Pages project site.
VITE_BASE_PATH=/
